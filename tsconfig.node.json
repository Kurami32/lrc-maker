{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "eslint.config.*",
    "tests/**/*"
  ],
  "compilerOptions": {
    // Most tools use transpilation instead of Node native type-stripping.
    "module": "preserve",
    "moduleResolution": "bundler",
    // Include Node types and avoid accidentally including other `@types/*` packages.
    "types": ["node"],
    // Disable emitting output during `vue-tsc --build`, which is used for type-checking.
    "noEmit": true,
    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
